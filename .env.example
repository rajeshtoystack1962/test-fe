# Copy to .env for local runs: cp .env.example .env
# On a server or in a container, set these as real environment variables instead.

# Where the Django API is. Used by `npm run dev` (Vite) and `npm start` (server.js).
BACKEND_URL=http://localhost:8000

# Port for `npm start` (server.js).
PORT=3000

# Leave empty so the browser stays on this app and /api is forwarded to Django.
# Read when Vite starts or when you run `npm run build`.
VITE_API_BASE_URL=
